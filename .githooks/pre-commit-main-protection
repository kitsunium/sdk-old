#!/bin/bash

# Git hook to prevent direct commits to main/master branches
# This hook will block commits to protected branches and suggest creating a feature branch

# Get the current branch name
BRANCH=$(git rev-parse --abbrev-ref HEAD)

# Define protected branches
PROTECTED_BRANCHES=("main" "master")

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

# Check if current branch is protected
for protected in "${PROTECTED_BRANCHES[@]}"; do
    if [[ "$BRANCH" == "$protected" ]]; then
        echo -e "${RED}❌ Direct commits to '$protected' branch are not allowed!${NC}"
        echo -e "${YELLOW}📝 Please create a feature branch and submit a pull request.${NC}"
        echo ""
        echo -e "${GREEN}To create a new branch:${NC}"
        echo "  git checkout -b feature/your-feature-name"
        echo ""
        echo -e "${GREEN}To move your changes to a new branch:${NC}"
        echo "  git stash"
        echo "  git checkout -b feature/your-feature-name"
        echo "  git stash pop"
        echo ""
        echo -e "${YELLOW}To bypass this check (NOT RECOMMENDED):${NC}"
        echo "  git commit --no-verify"
        exit 1
    fi
done

# If we get here, the branch is not protected
exit 0