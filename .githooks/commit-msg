#!/bin/bash

# Git hook to prevent commits with Claude-related mentions
# This hook is called with one argument: the name of the file
# that contains the commit message.

commit_msg_file="$1"
commit_msg=$(cat "$commit_msg_file")

# Define patterns to check
patterns=(
    "[Cc]laude"
    "Anthropic"
    "anthropic"
    "🤖.*[Cc]laude"
    "Co-[Aa]uthored-[Bb]y:.*[Cc]laude"
    "Co-[Aa]uthored-[Bb]y:.*noreply@anthropic"
    "[Gg]enerated with.*[Cc]laude"
    "claude\.ai"
)

# Colors for output
RED='\033[0;31m'
NC='\033[0m' # No Color

# Check each pattern
for pattern in "${patterns[@]}"; do
    if echo "$commit_msg" | grep -qE "$pattern"; then
        echo -e "${RED}ERROR: Commit message contains forbidden reference to AI assistant.${NC}"
        echo -e "${RED}Pattern matched: $pattern${NC}"
        echo ""
        echo "Please remove any references to:"
        echo "  - Claude or Anthropic"
        echo "  - AI assistant mentions"
        echo "  - Co-authored-by with AI"
        echo "  - Generated with AI tools"
        echo ""
        echo "Your commit message:"
        echo "---"
        echo "$commit_msg"
        echo "---"
        exit 1
    fi
done

# Check for 🤖 emoji (robot emoji often used for AI)
if echo "$commit_msg" | grep -q "🤖"; then
    echo -e "${RED}WARNING: Commit message contains robot emoji (🤖).${NC}"
    echo "This might indicate AI-generated content. Please review."
fi

exit 0