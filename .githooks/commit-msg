#!/usr/bin/env bash

set -Eeuo pipefail
IFS=$'\n\t'

# Git hook to prevent commits with Claude-related mentions
# This hook is called with one argument: the name of the file
# that contains the commit message.

commit_msg_file="${1:-}"
if [[ -z "$commit_msg_file" || ! -f "$commit_msg_file" ]]; then
  echo "ERROR: missing or invalid commit message file path." >&2
  exit 1
fi

# Optional: allow bypass in CI/emergency (export ALLOW_AI_MENTIONS=1)
if [[ "${ALLOW_AI_MENTIONS:-}" == "1" ]]; then
  exit 0
fi

commit_msg="$(cat -- "$commit_msg_file")"

# Define patterns to check (case-insensitive)
patterns=(
    "claude"
    "anthropic"
    "🤖.*claude"
    "^[[:space:]]*co-authored-by:.*(claude|anthropic)"
    "generated with.*claude"
    "claude\.ai"
)

# Colors for output (only if stdout is a TTY)
if [ -t 1 ]; then
  RED='\033[0;31m'
  YELLOW='\033[1;33m'
  NC='\033[0m' # No Color
else
  RED=''; YELLOW=''; NC='';
fi

# Check each pattern
for pattern in "${patterns[@]}"; do
    if echo "$commit_msg" | grep -qiE "$pattern"; then
        echo -e "${RED}ERROR: Commit message contains forbidden reference to AI assistant.${NC}"
        echo -e "${RED}Pattern matched: $pattern${NC}"
        echo ""
        echo "Please remove any references to:"
        echo "  - Claude or Anthropic"
        echo "  - AI assistant mentions"
        echo "  - Co-authored-by with AI"
        echo "  - Generated with AI tools"
        echo ""
        echo "Your commit message:"
        echo "---"
        echo "$commit_msg"
        echo "---"
        exit 1
    fi
done

# Check for 🤖 emoji (robot emoji often used for AI)
if echo "$commit_msg" | grep -q "🤖"; then
    echo -e "${YELLOW}WARNING: Commit message contains robot emoji (🤖).${NC}"
    echo "This might indicate AI-generated content. Please review."
fi

exit 0