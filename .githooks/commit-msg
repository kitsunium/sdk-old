#!/bin/bash
# Hook commit-msg : exécuté après la saisie du message de commit
# Reçoit en paramètre $1 : le chemin vers le fichier contenant le message
# Objectif : formater le code et vérifier que le message suit les conventions

# Active les modes stricts de bash :
# -e : arrête le script si une commande échoue
# -u : arrête si une variable non définie est utilisée
# -o pipefail : arrête si une commande dans un pipe échoue
set -euo pipefail

# Définit le séparateur de champs interne (pour les boucles)
# $'\n\t' signifie : newline et tab uniquement
IFS=$'\n\t'

# Récupère le chemin du fichier contenant le message de commit
# $1 est le premier argument passé au script par Git
commit_msg_file="$1"

# Lit le contenu du fichier de message dans une variable
# $(cat ...) exécute cat et capture sa sortie
commit_msg=$(cat "$commit_msg_file")

# ============================================
# ÉTAPE 1 : Exécuter le formatage automatique
# ============================================

# Vérifie si la commande 'task' est installée
if command -v task &> /dev/null; then
    echo "🔧 Running code formatting before commit..."
    # Exécute le formatage
    # Si des fichiers sont modifiés, ils seront automatiquement ajoutés au commit
    if task fmt; then
        # Si des fichiers ont été formatés, les ajouter au staging
        # git diff --name-only : liste les fichiers modifiés
        # xargs : passe la liste à git add
        git diff --name-only | xargs -r git add 2>/dev/null || true
        echo "✅ Code formatting completed"
    else
        echo "⚠️  Code formatting had issues but continuing..."
    fi
else
    echo "⚠️  'task' command not found, skipping formatting"
fi

# ============================================
# ÉTAPE 2 : Valider le format du message
# ============================================

# Définit les préfixes valides pour les conventional commits
# Ce sont les types de commits acceptés selon la convention
valid_prefixes=(
    "feat"      # Nouvelle fonctionnalité
    "fix"       # Correction de bug
    "docs"      # Documentation uniquement
    "style"     # Formatage, point-virgules manquants, etc.
    "refactor"  # Refactoring du code
    "perf"      # Amélioration des performances
    "test"      # Ajout ou correction de tests
    "build"     # Changements au système de build
    "ci"        # Changements aux fichiers CI
    "chore"     # Autres changements (maintenance)
    "revert"    # Annulation d'un commit précédent
    "merge"     # Commit de merge
    "wip"       # Work in progress (travail en cours)
)

# Construit une expression régulière avec tous les préfixes
# IFS='|' : utilise | comme séparateur pour joindre les éléments
# "${valid_prefixes[*]}" : tous les éléments du tableau joints
regex_pattern="^($(IFS='|'; echo "${valid_prefixes[*]}"))"

# Vérifie si le message commence par un préfixe valide
# grep -qiE : 
#   -q : mode silencieux (pas de sortie)
#   -i : insensible à la casse
#   -E : expression régulière étendue
# ! inverse le test : si grep NE trouve PAS de correspondance
if ! echo "$commit_msg" | grep -qiE "$regex_pattern"; then
    # Affiche un message d'erreur en rouge si le terminal le supporte
    echo -e "\033[31m❌ Invalid commit message format!\033[0m"
    echo ""
    echo "Your commit message must start with one of these prefixes:"
    echo ""
    
    # Boucle pour afficher chaque préfixe valide
    # for prefix in ... : parcourt chaque élément du tableau
    for prefix in "${valid_prefixes[@]}"; do
        # Affiche le préfixe avec un exemple d'utilisation
        echo "  - $prefix: <description>"
    done
    
    echo ""
    echo "Example: feat: add user authentication"
    echo ""
    echo "Your message was:"
    # Affiche le message rejeté en jaune
    echo -e "\033[33m$commit_msg\033[0m"
    
    # Sort avec code d'erreur 1, empêchant le commit
    exit 1
fi

# ============================================
# ÉTAPE 3 : Vérifications supplémentaires
# ============================================

# Vérifie la longueur de la première ligne (résumé)
# head -n 1 : prend seulement la première ligne
# wc -c : compte le nombre de caractères
# tr -d ' ' : supprime les espaces (wc ajoute des espaces)
first_line_length=$(echo "$commit_msg" | head -n 1 | wc -c | tr -d ' ')

# Si la première ligne dépasse 72 caractères (convention Git)
if [ "$first_line_length" -gt 72 ]; then
    # Avertissement en jaune (ne bloque pas le commit)
    echo -e "\033[33m⚠️  Warning: First line of commit message exceeds 72 characters.\033[0m"
    echo "Consider making it more concise."
fi

# Vérifie si le message contient des mots-clés liés à l'IA
# Définit les patterns à rechercher (mentions d'IA)
ai_patterns=(
    "claude"
    "anthropic"
    "generated by"
    "ai-generated"
    "copilot"
)

# Construit une regex pour les patterns IA
ai_regex="($(IFS='|'; echo "${ai_patterns[*]}"))"

# Si on trouve une mention d'IA et que ALLOW_AI_MENTIONS n'est pas défini
# ${ALLOW_AI_MENTIONS:-} : utilise la variable ou une chaîne vide si non définie
if echo "$commit_msg" | grep -qiE "$ai_regex" && [ -z "${ALLOW_AI_MENTIONS:-}" ]; then
    # Simple avertissement, ne bloque pas
    echo -e "\033[33m📝 Note: AI-related content detected in commit message.\033[0m"
fi

# Si on arrive ici, le message est valide
echo "✅ Commit message validation passed!"
# Sort avec succès (code 0), le commit continue