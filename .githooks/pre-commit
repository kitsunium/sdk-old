#!/bin/bash
# Pre-commit hook: check code quality and format code before commit

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Source the main branch protection hook
HOOK_DIR="$(dirname "$0")"
if [ -f "$HOOK_DIR/pre-commit-main-protection" ]; then
    source "$HOOK_DIR/pre-commit-main-protection"
fi

echo "🔍 Running pre-commit checks..."

# Function to check for t.Skip() usage
check_test_skip() {
    echo "Checking for t.Skip() usage in test files..."
    
    # Find all test files that are staged
    test_files=$(git diff --cached --name-only --diff-filter=ACM | grep '_test\.go$' || true)
    
    if [ -z "$test_files" ]; then
        return 0
    fi
    
    # Check each test file for t.Skip
    found_skip=false
    for file in $test_files; do
        # Check the staged content (not the working directory)
        if git diff --cached "$file" | grep -E '^\+.*t\.Skip\(' > /dev/null 2>&1; then
            found_skip=true
            echo -e "${RED}✗ Found t.Skip() in $file${NC}"
            
            # Show the lines with t.Skip
            echo -e "${YELLOW}Lines with t.Skip():${NC}"
            git diff --cached "$file" | grep -E '^\+.*t\.Skip\(' | sed 's/^+/  /'
        fi
    done
    
    if [ "$found_skip" = true ]; then
        echo ""
        echo -e "${RED}════════════════════════════════════════════════════════════════${NC}"
        echo -e "${RED}✗ COMMIT BLOCKED: t.Skip() detected in test files${NC}"
        echo -e "${RED}════════════════════════════════════════════════════════════════${NC}"
        echo ""
        echo -e "${YELLOW}Using t.Skip() is a bad practice that should be avoided.${NC}"
        echo ""
        echo "Instead of skipping tests, you should:"
        echo "  1. Fix the package if the test logic is correct"
        echo "  2. Adjust the test expectations without compromising its purpose"
        echo "  3. Remove the test if it's no longer relevant"
        echo ""
        echo "Tests should either:"
        echo "  • Pass (✓) - indicating the code works correctly"
        echo "  • Fail (✗) - indicating a real issue that needs fixing"
        echo ""
        echo "Skipping tests hides problems and reduces confidence in the codebase."
        echo ""
        return 1
    fi
    
    echo -e "${GREEN}✓ No t.Skip() found in test files${NC}"
    return 0
}

# Check for t.Skip() first (blocking check)
check_test_skip || exit 1

echo ""
echo "🎨 Running pre-commit formatting..."

# Get list of staged Go files
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)

if [ -n "$STAGED_GO_FILES" ]; then
    echo "📝 Formatting staged Go files..."
    
    # Format each staged Go file
    for file in $STAGED_GO_FILES; do
        if [ -f "$file" ]; then
            # Format the file
            gofmt -w "$file"
            
            # Run goimports if available
            if command -v goimports >/dev/null 2>&1; then
                goimports -w "$file"
            fi
            
            # Re-add the file to staging after formatting
            git add "$file"
        fi
    done
    
    echo "✅ Go files formatted and re-staged"
fi

# Update Bazel BUILD files if gazelle is available
if command -v bazel >/dev/null 2>&1; then
    echo "🏗️ Updating BUILD files with Gazelle..."
    bazel run //:gazelle --noshow_progress 2>/dev/null || true
    
    # Re-stage any modified BUILD files
    MODIFIED_BUILD_FILES=$(git diff --name-only | grep 'BUILD.bazel$' || true)
    if [ -n "$MODIFIED_BUILD_FILES" ]; then
        for file in $MODIFIED_BUILD_FILES; do
            git add "$file"
        done
        echo "✅ BUILD files updated and re-staged"
    fi
fi

# Format YAML, JSON, and Markdown files if prettier is available
if command -v prettier >/dev/null 2>&1; then
    STAGED_FORMATTED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(yml|yaml|json|md)$' || true)
    
    if [ -n "$STAGED_FORMATTED_FILES" ]; then
        echo "📝 Formatting YAML/JSON/Markdown files..."
        for file in $STAGED_FORMATTED_FILES; do
            if [ -f "$file" ]; then
                prettier --write "$file" 2>/dev/null || true
                git add "$file"
            fi
        done
        echo "✅ YAML/JSON/Markdown files formatted and re-staged"
    fi
fi

# Quick vet check on staged Go files (non-blocking)
if [ -n "$STAGED_GO_FILES" ]; then
    echo "🔍 Running quick go vet check..."
    # Extract unique directories from staged files
    DIRS=$(echo "$STAGED_GO_FILES" | xargs -n1 dirname | sort -u)
    for dir in $DIRS; do
        go vet "./$dir" 2>&1 | grep -v "^#" || true
    done
fi

echo "✨ Pre-commit formatting complete!"
echo "💡 Your files have been formatted and re-staged automatically."
exit 0