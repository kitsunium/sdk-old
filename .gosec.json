{
  "global": {
    "nosec": "enabled",
    "audit": "enabled",
    "exclude-dir": ["vendor", "node_modules", ".git", "bazel-*", "dist"]
  },
  "rules": {
    "G101": {
      "description": "Look for hard coded credentials",
      "severity": "HIGH",
      "confidence": "LOW"
    },
    "G102": {
      "description": "Bind to all interfaces",
      "severity": "MEDIUM",
      "confidence": "HIGH"
    },
    "G103": {
      "description": "Audit the use of unsafe block",
      "severity": "LOW",
      "confidence": "HIGH"
    },
    "G104": {
      "description": "Audit errors not checked",
      "severity": "LOW",
      "confidence": "HIGH"
    },
    "G201": {
      "description": "SQL query construction using format string",
      "severity": "HIGH",
      "confidence": "MEDIUM"
    },
    "G202": {
      "description": "SQL query construction using string concatenation",
      "severity": "HIGH",
      "confidence": "MEDIUM"
    },
    "G301": {
      "description": "Poor file permissions used when creating a directory",
      "severity": "MEDIUM",
      "confidence": "HIGH"
    },
    "G302": {
      "description": "Poor file permissions used with chmod",
      "severity": "MEDIUM",
      "confidence": "HIGH"
    },
    "G303": {
      "description": "Creating tempfile using a predictable path",
      "severity": "MEDIUM",
      "confidence": "HIGH"
    },
    "G304": {
      "description": "File path provided as taint input",
      "severity": "HIGH",
      "confidence": "HIGH"
    },
    "G401": {
      "description": "Detect the usage of DES, RC4, MD5 or SHA1",
      "severity": "HIGH",
      "confidence": "HIGH"
    },
    "G501": {
      "description": "Import blocklist: crypto/md5",
      "severity": "HIGH",
      "confidence": "HIGH"
    },
    "G502": {
      "description": "Import blocklist: crypto/des",
      "severity": "HIGH",
      "confidence": "HIGH"
    },
    "G503": {
      "description": "Import blocklist: crypto/rc4",
      "severity": "HIGH",
      "confidence": "HIGH"
    },
    "G504": {
      "description": "Import blocklist: net/http/cgi",
      "severity": "HIGH",
      "confidence": "HIGH"
    },
    "G601": {
      "description": "Implicit memory aliasing in for loop",
      "severity": "LOW",
      "confidence": "MEDIUM"
    }
  },
  "exclude-rules": ["G104"],
  "exclude-files": ["_test.go$", "wire_gen.go$", ".pb.go$"],
  "confidence": "medium",
  "severity": "medium",
  "concurrency": 4,
  "tests": false,
  "exclude-generated": true,
  "fmt": "json",
  "verbose": ""
}
