load("@rules_go//go:def.bzl", "go_test")
load("//build:go_rules.bzl", "kitsunium_go_library", "kitsunium_go_test")

# =============================================================================
# Kitsunium SDK - normalize package
# 2 modes: TEST (with race detection) and BENCHMARK (production performance)
# =============================================================================

kitsunium_go_library(
    name = "normalize",
    importpath = "github.com/kitsunium/sdk/pkg/core/config/normalize",
)

# =============================================================================
# MODE 1: TEST - Unit tests with race detection and safety checks
# =============================================================================

kitsunium_go_test(
    name = "test",
    size = "small",
    embed = [":normalize"],
)

# No benchmark files exist for this package

go_test(
    name = "normalize_test",
    size = "small",
    srcs = [
        "normalize_coverage_test.go",
        "normalize_test.go",
    ],
    embed = [":normalize"],
)

alias(
    name = "go_default_library",
    actual = ":normalize",
    visibility = ["//visibility:public"],
)
