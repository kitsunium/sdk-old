load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "kbuffer",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    importpath = "github.com/kitsunium/sdk/pkg/kernel/kbuffer",
    visibility = ["//visibility:public"],
