load("@rules_go//go:def.bzl", "go_test")
load("//build:go_rules.bzl", "kitsunium_go_benchmark", "kitsunium_go_library", "kitsunium_go_test")

# =============================================================================
# Kitsunium SDK - kbuffer package
# 2 modes: TEST (with race detection) and BENCHMARK (production performance)
# =============================================================================

kitsunium_go_library(
    name = "kbuffer",
    importpath = "github.com/kitsunium/sdk/pkg/kernel/kbuffer",
)

# =============================================================================
# MODE 1: TEST - Unit tests with race detection and safety checks
# =============================================================================

kitsunium_go_test(
    name = "test",
    size = "small",
    embed = [":kbuffer"],
)

# =============================================================================
# MODE 2: BENCHMARK - Production benchmarks without safety checks
# =============================================================================

# Single-core benchmark
kitsunium_go_benchmark(
    name = "bench",
    embed = [":kbuffer"],
)

# Multi-core benchmark
kitsunium_go_benchmark(
    name = "bench_multi",
    srcs = ["kbuffer_bench_test.go"],
    embed = [":kbuffer"],
)

go_test(
    name = "kbuffer_test",
    size = "small",
    srcs = [
        "goroutine_check_test.go",
        "interface_test.go",
        "kbuffer_bench_multi_test.go",
        "kbuffer_bench_test.go",
        "safe_buffer_test.go",
        "safe_sharded_test.go",
        "unsafe_buffer_race_test.go",
        "unsafe_buffer_test.go",
        "unsafe_sharded_race_test.go",
        "unsafe_sharded_test.go",
    ],
    embed = [":kbuffer"],
)

alias(
    name = "go_default_library",
    actual = ":kbuffer",
    visibility = ["//visibility:public"],
)
