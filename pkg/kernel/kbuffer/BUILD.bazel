load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "kbuffer",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    importpath = "github.com/kitsunium/sdk/pkg/kernel/kbuffer",
    visibility = ["//visibility:public"],
)

go_test(
    name = "test",
    size = "small",
    timeout = "short",
    srcs = glob(
        ["*_test.go"],
        exclude = [
            "*_bench_test.go",
            "*_race_test.go",  # Exclude intentional data race tests
        ],
    ),
    embed = [":kbuffer"],
    race = "on",
)

go_test(
    name = "bench",
    size = "large",
    timeout = "long",
    srcs = glob(["*_bench_test.go"]),
    args = [
        "-test.run=^$$",
        "-test.bench=.",
        "-test.benchmem",
        "-test.count=1",
        "-test.cpu=1",
        "-test.benchtime=3s",
    ],
    embed = [":kbuffer"],
    local = True,
    tags = [
        "benchmark",
        "manual",
    ],
)

go_test(
    name = "bench_prod",
    size = "large",
    timeout = "long",
    srcs = glob(["*_bench_test.go"]),
    args = [
        "-test.run=^$$",
        "-test.bench=.",
        "-test.benchmem",
        "-test.count=1",
        "-test.cpu=1",
        "-test.benchtime=3s",
    ],
    embed = [":kbuffer"],
    gotags = ["unsafe_no_check"],
    local = True,
    tags = [
        "benchmark",
        "manual",
    ],
)

go_test(
    name = "race_test",
    size = "small",
    timeout = "short",
    srcs = glob(["*_race_test.go"]),
    embed = [":kbuffer"],
    race = "off",  # Intentionally disabled for data race testing
    tags = ["manual"],  # Don't run automatically in CI
)

go_test(
    name = "kbuffer_test",
    srcs = [
        "global_test.go",
        "goroutine_check_test.go",
        "interface_test.go",
        "kbuffer_bench_test.go",
        "safe_buffer_test.go",
        "safe_sharded_test.go",
        "unsafe_buffer_race_test.go",
        "unsafe_buffer_test.go",
        "unsafe_sharded_race_test.go",
        "unsafe_sharded_test.go",
    ],
    embed = [":kbuffer"],
)
