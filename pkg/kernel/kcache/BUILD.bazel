load("@rules_go//go:def.bzl", "go_test")
load("//build:go_rules.bzl", "kitsunium_go_benchmark", "kitsunium_go_library", "kitsunium_go_test")

# =============================================================================
# Kitsunium SDK - kcache package
# Ultra-optimized kernel cache with unsafe operations
# =============================================================================

kitsunium_go_library(
    name = "kcache",
    importpath = "github.com/kitsunium/sdk/pkg/kernel/kcache",
)

# =============================================================================
# MODE 1: TEST - Unit tests with race detection and safety checks
# =============================================================================

kitsunium_go_test(
    name = "test",
    size = "small",
    embed = [":kcache"],
)

# =============================================================================
# MODE 2: BENCHMARK - Production benchmarks without safety checks
# =============================================================================

# Single-core benchmark
kitsunium_go_benchmark(
    name = "bench",
    embed = [":kcache"],
)

# Multi-core benchmark
kitsunium_go_benchmark(
    name = "bench_multi",
    embed = [":kcache"],
)

go_test(
    name = "kcache_test",
    size = "small",
    srcs = [
        "batch_test.go",
        "global_test.go",
        "hasher_test.go",
        "kcache_bench_test.go",
        "options_test.go",
        "pool_test.go",
        "safe_cache_test.go",
        "safe_sharded_race_test.go",
        "safe_sharded_test.go",
        "unsafe_cache_test.go",
        "unsafe_sharded_test.go",
    ],
    embed = [":kcache"],
)

alias(
    name = "go_default_library",
    actual = ":kcache",
    visibility = ["//visibility:public"],
)
