load("@rules_go//go:def.bzl", "go_test")
load("//build:go_rules.bzl", "kitsunium_go_benchmark", "kitsunium_go_library", "kitsunium_go_test")

# =============================================================================
# Kitsunium SDK - fs package
# 2 modes: TEST (with race detection) and BENCHMARK (production performance)
# =============================================================================

kitsunium_go_library(
    name = "fs",
    importpath = "github.com/kitsunium/sdk/pkg/kernel/fs",
    is_kernel = True,
    deps = [
        "//pkg/lib/pointer",
        "@org_golang_x_sys//unix",
    ],
)

# =============================================================================
# MODE 1: TEST - Unit tests with race detection and safety checks
# =============================================================================

kitsunium_go_test(
    name = "test",
    size = "small",
    embed = [":fs"],
    deps = [
        "//pkg/lib/pointer",
        "@com_github_stretchr_testify//assert",
    ],
)

# =============================================================================
# MODE 2: BENCHMARK - Production benchmarks without safety checks
# =============================================================================

# Single-core benchmark
kitsunium_go_benchmark(
    name = "bench",
    embed = [":fs"],
    deps = [
        "//pkg/lib/pointer",
        "@com_github_stretchr_testify//assert",
    ],
)

# Multi-core benchmark
kitsunium_go_benchmark(
    name = "bench_multi",
    srcs = ["fs_bench_test.go"],
    embed = [":fs"],
    deps = [
        "//pkg/lib/pointer",
        "@com_github_stretchr_testify//assert",
    ],
)

go_test(
    name = "fs_test",
    size = "small",
    srcs = [
        "archive_test.go",
        "directory_test.go",
        "file_test.go",
        "fs_bench_test.go",
        "host_test.go",
        "option_test.go",
        "stats_test.go",
    ],
    deps = [
        ":fs",  # keep
        "//pkg/lib/pointer",  # keep
        "@com_github_stretchr_testify//assert",
    ],
)

alias(
    name = "go_default_library",
    actual = ":fs",
    visibility = ["//visibility:public"],
)
