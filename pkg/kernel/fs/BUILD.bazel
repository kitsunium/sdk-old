go_test(
    name = "fs_test",
    size = "small",
    srcs = [
        "archive_test.go",
        "directory_test.go",
        "file_test.go",
        "stats_test.go",
    ],
    deps = [
        ":fs",
        "//pkg/lib/pointer",
        "@com_github_stretchr_testify//assert",
    ],
)
