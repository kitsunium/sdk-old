load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "fs",
    srcs = [
        "archive.go",
        "directory.go",
        "file.go",
        "host.go",
        "option.go",
        "stats.go",
        "system.go",
    ],
    importpath = "github.com/kitsunium/sdk/pkg/kernel/fs",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/lib/pointer",
        "@org_golang_x_sys//unix",
    ],
