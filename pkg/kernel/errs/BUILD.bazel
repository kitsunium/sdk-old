load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "errs",
    srcs = [
        "config.go",
        "context.go",
        "error.go",
        "instance.go",
        "metrics.go",
        "registry.go",
        "result.go",
    ],
    importpath = "github.com/kitsunium/sdk/pkg/kernel/errs",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/kernel/cache",
